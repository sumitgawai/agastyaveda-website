PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
GOOGLE_MAPS_API_KEY=
# Leave false on Railway; Railway DNS should resolve Atlas SRV records.
FORCE_PUBLIC_DNS=false
# Example only. Replace with the complete URI copied from Atlas > Connect > Drivers.
# Atlas Network Access must contain your current public IP (or approved CIDR range).
MONGODB_URI=
MONGODB_DB=agastyaveda
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Local-only demo mode. Never enable this in production.
LOCAL_AUTH_BYPASS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hello@agastyaveda.in
ADMIN_EMAIL=admin@agastyaveda.in
ADMIN_ACCESS_EMAIL=agastyaaveda@gmail.com
ADMIN_CLERK_IDS=
CONSULTATION_FEE=1200
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
# Optional private document storage. Keep the bucket private.
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
